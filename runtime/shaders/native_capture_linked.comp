#version 450
//! gl_version 430
#include "native_prelude.glsl"
layout(local_size_x=128) in;
layout(std430,PSX_BINDING(0,0)) buffer Metadata { uint meta[]; };
layout(std430,PSX_BINDING(1,1)) buffer Fragments { uint words[]; };
layout(rgba8,PSX_BINDING(2,2)) uniform image2D color_image;
layout(r32ui,PSX_BINDING(3,3)) uniform uimage2D depth_image;
#ifdef VULKAN
layout(push_constant) uniform CapturePush { vec4 view; ivec4 rect; uvec4 info; };
#else
uniform vec4 view; uniform ivec4 rect; uniform uvec4 info;
#endif
uvec4 node_at(uint index){uint at=index*5u;return uvec4(words[at],words[at+1u],words[at+2u],words[at+3u]);}
uint next_at(uint index){return words[index*5u+4u];}
void ordered_pair(inout uvec4 a,inout uvec4 b){if(a.x>b.x){uvec4 t=a;a=b;b=t;}}
/* A pixel owns its entire chain. Merge its links in place instead of scanning
 * every node for each output fragment when material batches arrive out of order. */
uint sort_chain(uint head,uint count){
 for(uint span=1u;span<count;span*=2u){
  uint cursor=head,remaining=count,first=0xffffffffu,tail=0xffffffffu;
  while(remaining!=0u){
   uint left=cursor,nl=min(span,remaining),right=left;
   for(uint j=0u;j<nl;++j)right=next_at(right);
   uint nr=min(span,remaining-nl);cursor=right;
   for(uint j=0u;j<nr;++j)cursor=next_at(cursor);
   remaining-=nl+nr;
   while(nl!=0u||nr!=0u){uint selected;
    bool take_left=nr==0u;
    if(nl!=0u&&nr!=0u)take_left=words[left*5u]<=words[right*5u];
    if(take_left){selected=left;left=next_at(left);--nl;}
    else{selected=right;right=next_at(right);--nr;}
    if(tail==0xffffffffu)first=selected;else words[tail*5u+4u]=selected;
    tail=selected;
   }
  }
  words[tail*5u+4u]=0xffffffffu;head=first;
 }
 return head;
}
void main(){
 uint pixels=uint(rect.z*rect.w),pixel=gl_GlobalInvocationID.x;
 if(pixel>=pixels||meta[0]!=0u)return;
 uint count=meta[4u+pixels+pixel],head=meta[4u+pixel];if(count==0u)return;
 if(count>128u||head>=info.y){atomicOr(meta[0],8u);return;}
 bool ascending=true,descending=true;uint cursor=head,prior=node_at(head).x;
 for(uint j=1u;j<count;++j){cursor=next_at(cursor);
  if(cursor>=info.y){atomicOr(meta[0],16u);return;}
  uint order=node_at(cursor).x;ascending=ascending&&order>prior;descending=descending&&order<prior;prior=order;
 }
 if(descending&&!ascending){uint reversed=0xffffffffu;cursor=head;
  for(uint j=0u;j<count;++j){if(cursor>=info.y){atomicOr(meta[0],64u);return;}
   uint next=next_at(cursor);words[cursor*5u+4u]=reversed;reversed=cursor;cursor=next;}
   head=reversed;ascending=true;}
 uvec4 a=uvec4(0xffffffffu),b=a,c=a,d=a;
 bool small=!ascending&&count<=4u;
 if(small){cursor=head;
  a=node_at(cursor);cursor=next_at(cursor);
  if(count>1u){b=node_at(cursor);cursor=next_at(cursor);}
  if(count>2u){c=node_at(cursor);cursor=next_at(cursor);}
  if(count>3u)d=node_at(cursor);
  ordered_pair(a,b);ordered_pair(c,d);ordered_pair(a,c);ordered_pair(b,d);ordered_pair(b,c);
 }else if(!ascending){head=sort_chain(head,count);ascending=true;}
 ivec2 p=ivec2(int(pixel%uint(rect.z)),int(pixel/uint(rect.z)))+rect.xy;
 uint rgba=packUnorm4x8(imageLoad(color_image,p)),key=imageLoad(depth_image,p).r;
 uint previous=0u;cursor=head;
 for(uint done=0u;done<count;++done){uvec4 selected=uvec4(0xffffffffu);
  if(ascending){if(cursor>=info.y){atomicOr(meta[0],128u);return;}selected=node_at(cursor);cursor=next_at(cursor);}
   else selected=done==0u?a:done==1u?b:done==2u?c:d;
  if(selected.x==0xffffffffu){atomicOr(meta[0],32u);return;}
  previous=selected.x;uint bits=selected.w;
  if((bits&(1u<<20u))!=0u&&(rgba>>24u)>127u)continue;
  if((bits&(1u<<21u))!=0u&&selected.z<key-(key>>10u))continue;
  ivec3 c=ivec3(int(bits&31u),int((bits>>5u)&31u),int((bits>>10u)&31u));
  bool blend=(bits&(1u<<16u))!=0u;
  if(blend){ivec3 old=ivec3(int(rgba&255u),int((rgba>>8u)&255u),int((rgba>>16u)&255u))>>3;
   uint mode=(bits>>18u)&3u;
   if(mode==0u)c=(old+c)/2;else if(mode==1u)c=old+c;else if(mode==2u)c=old-c;else c=old+c/4;}
  c=clamp(c,ivec3(0),ivec3(31));c=(c<<3)|(c>>2);
  uint alpha=(((bits>>15u)&1u)*2u+((bits>>17u)&1u))*85u;
  rgba=uint(c.r)|(uint(c.g)<<8u)|(uint(c.b)<<16u)|(alpha<<24u);
  uint write_mode=(bits>>22u)&7u;
  key=write_mode==4u?1u:blend?((bits&(1u<<25u))!=0u?key:0u):write_mode==2u?selected.y:0u;
 }
 imageStore(color_image,p,unpackUnorm4x8(rgba));
 if(info.w!=0u)imageStore(depth_image,p,uvec4(key));
}
